# Copy this file to .env and fill in the values. .env is gitignored; this
# template is tracked so the variable names are written down somewhere.
# docker-compose.yml reads PGUSER, PGPASSWORD and PGDATABASE from .env to set up
# the container. The PG* names are also the standard ones psql and Postgres
# client libraries read, and DATABASE_URL is the same settings as one string,
# so a future server can connect without its own copy of the credentials.
# Postgres reads the credentials only when it first creates the pgdata volume;
# changing them later does not change the existing user or password.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DATABASE"
PGHOST="localhost"
PGPORT="5432"
PGUSER=""
PGPASSWORD=""
PGDATABASE=""
